VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional — set as a Supabase Edge Function secret (NOT a VITE_ variable):
# MAPBOX_ACCESS_TOKEN=pk.or.sk.from.mapbox
# If unset, the geocode-address function uses OpenStreetMap Nominatim.
# GOOGLE_PLACES_API_KEY=your_places_api_new_key
# If unset, Nearby Finder opens Google Maps instead of in-app results.
